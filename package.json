{
  "name": "streamscribe",
  "version": "1.0.0",
  "description": "Capture public meeting livestreams, fill gaps from the official archive, transcribe locally with Whisper, and review them with speakers, chapters, votes, and clips.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node bin/dev.js",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "capture": "node bin/capture.js",
    "report-stream-identifiers": "node bin/report-stream-identifiers.js",
    "transcribe": "node bin/transcribe.js",
    "transcribe-media": "node bin/transcribe-media.js",
    "transcript-corrections": "node bin/transcript-corrections.js",
    "combine-transcripts": "node bin/combine-transcripts.js",
    "split-session": "node bin/split-session.js",
    "join-sessions": "node bin/join-sessions.js",
    "extract-slides": "node bin/extract-slides.js",
    "extract-thumbnails": "node bin/extract-thumbnails.js",
    "extract-clip": "node bin/extract-clip.js",
    "render-playlist": "node bin/render-playlist.js",
    "render-mp4": "node bin/render-mp4.js",
    "backfill-from-archive": "node bin/backfill-from-archive.js",
    "build-meeting": "node bin/build-meeting.js",
    "retranscribe-range": "node bin/retranscribe-range.js",
    "classify-swagit-standby": "node bin/classify-swagit-standby.js",
    "test": "node --test test/*.test.js",
    "simulate-hls": "node bin/simulate-hls.js",
    "recorder": "node bin/recorder.js",
    "test:recorder": "node --test test/recorder.e2e.js",
    "deploy:hub": "bin/deploy-hub.sh",
    "hub:dev": "php -S 127.0.0.1:8080 -t hub-php",
    "publish-library": "node bin/publish-library.js",
    "publish-media": "node bin/publish-media.js",
    "lint": "oxlint && npm run lint:php",
    "lint:php": "find hub-php -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
