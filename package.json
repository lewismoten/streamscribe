{
  "name": "streamscribe",
  "version": "1.0.0",
  "description": "Capture public meeting livestreams, fill gaps from the official archive, transcribe locally with Whisper, and review them with speakers, chapters, votes, and clips.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "capture": "node scripts/capture.js",
    "report-stream-identifiers": "node scripts/report-stream-identifiers.js",
    "transcribe": "node scripts/transcribe.js",
    "transcribe-media": "node scripts/transcribe-media.js",
    "transcript-corrections": "node scripts/transcript-corrections.js",
    "split-session": "node scripts/split-session.js",
    "join-sessions": "node scripts/join-sessions.js",
    "extract-slides": "node scripts/extract-slides.js",
    "extract-thumbnails": "node scripts/extract-thumbnails.js",
    "extract-clip": "node scripts/extract-clip.js",
    "render-mp4": "node scripts/render-mp4.js",
    "backfill-from-archive": "node scripts/backfill-from-archive.js",
    "build-meeting": "node scripts/build-meeting.js",
    "retranscribe-range": "node scripts/retranscribe-range.js",
    "classify-swagit-standby": "node scripts/providers/swagit/classify-standby-slides.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
