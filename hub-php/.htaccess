# Only api.php and media/ are meant to be reached from the web.
Options -Indexes
<FilesMatch "^(config\.php|config\.example\.php|schema\.sql)$">
  Require all denied
</FilesMatch>
RedirectMatch 403 ^.*/(lib|tools|data|agent)/
# Some hosts drop the custom key header unless it is passed through explicitly.
SetEnvIf X-Streamscribe-Key "(.*)" HTTP_X_STREAMSCRIBE_KEY=$1
SetEnvIf X-Streamscribe-Token "(.*)" HTTP_X_STREAMSCRIBE_TOKEN=$1

# Published files are public: other sites showing them (GitHub Pages) may fetch their transcripts, captions, clips,
# and pictures (players with captions load media in CORS mode).
<IfModule mod_headers.c>
  <FilesMatch "^(transcript\.json|transcript\.txt|captions\.srt|captions\.vtt|clip-[0-9a-f]+\.(mp4|m4a)|poster\.jpg)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
